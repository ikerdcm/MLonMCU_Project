# MAX78000 KWS20 measurement config

# Paths
export KWS20_PROJECT="$HOME/max78000/ai8x-synthesis/sdk/Examples/MAX78000/CNN/kws20_demo"
export KWS20_VENV="$HOME/max78000/ai8x-synthesis/.venv"
export KWS20_SCRIPT="$HOME/max78000/tools/kws20_measure_everything.py"
export KWS20_MANIFEST="$HOME/max78000/accuracy_test/manifest.csv"

# Board / UART
export KWS20_BOARD="FTHR_RevA"
export KWS20_PORT="/dev/ttyACM0"
export KWS20_BAUD="115200"

# Measurement settings
export KWS20_DURATION="120"
export KWS20_RESPONSE_WINDOW="2.5"

# Model / signal assumptions
export KWS20_SAMPLE_RATE="16000"
export KWS20_SAMPLE_COUNT="16384"
export KWS20_CLOCK_MHZ="100"

# Optional values.
# Fill these in once you know them.
export KWS20_MAC_OPS=""
export KWS20_VOLTAGE=""
export KWS20_CURRENT_MA=""
